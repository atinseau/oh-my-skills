{
  "name": "oh-my-skills",
  "version": "1.2.0",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "prepare": "lefthook install",
    "check-types": "tsc --noEmit",
    "check": "biome check --write --unsafe",
    "pretest": "bun run test:image",
    "test": "bun test --parallel --timings=tests/timings.json --timeout 60000",
    "test:image": "docker build -t oh-my-skills-test:latest tests/",
    "test:timings": "bun test --parallel --timings=tests/timings.json --update-timings --timeout 60000",
    "docker:build": "docker build -t oh-my-skills .",
    "predocker:run": "bun docker:build",
    "docker:run": "docker run -it --rm oh-my-skills bash"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "testcontainers": "11.12.0",
    "@biomejs/biome": "2.4.3",
    "lefthook": "2.1.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
